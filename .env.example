# Copy to .env and fill in. Never commit .env.

# --- App builds (machine-specific; platform-specific var beats generic) ---
IOS_APP_PATH=
ANDROID_APP_PATH=
# APP_PATH=            # generic fallback, handy in single-platform CI jobs

# --- Device targeting (override capabilities/<platform>.yaml) ---
# DEVICE_NAME=         # e.g. "iPhone 18 Pro" / emulator-5554
# UDID=                # pin a specific real device / simulator
# Parallel (xdist): one device per worker
# DEVICE_NAME_GW0= / UDID_GW0= / APPIUM_SERVER_URL_GW0= ...

# --- App identity (override app_id in capabilities yaml, e.g. testing another flavor) ---
# IOS_APP_ID=          # bundle id
# ANDROID_APP_ID=      # package name
# APP_ID=              # generic fallback

# --- Tuning ---
# APPIUM_SERVER_URL=   # defaults to http://127.0.0.1:4723
# EXPLICIT_WAIT=       # element wait seconds (defaults from environments yaml)
# RERUNS=              # flaky-retry count; explicit --reruns wins
# API_TIMEOUT=         # API client timeout seconds (default 10)

# --- Secrets (CI: repository secrets with the same names) ---
# Real secrets go here when the app under test needs them; disposable
# clone-app test data lives directly in the feature files instead.
